# ==========================================
# SortMySkills Production Environment Variables
# ==========================================

# 1. Supabase Connection (REQUIRED for Auth, Profiles, Sessions, and Telemetry)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. SMTP Mail Configurations (OPTIONAL)
# Note: The core platform utilizes Supabase Auth for transactional OTP email verification.
# These Gmail SMTP credentials are only required if custom Nodemailer email sending in `src/lib/email.ts` is explicitly imported and enabled.
GMAIL_SMTP_USER=your_gmail_username@gmail.com
GMAIL_SMTP_PASSWORD=your_gmail_app_password
GMAIL_SENDER_EMAIL=your_gmail_username@gmail.com
GMAIL_SENDER_NAME=SortMySkills

# 3. Groq AI API Key Configurations (REQUIRED for Study Roadmap generation)
# Supports multi-key failover to prevent rate-limit denials on primary endpoints.
GROQ_API_KEY=your_default_fallback_groq_api_key

# Unified workspace - Roadmap study plan generation endpoints (1 primary, 1 fallback)
GROQ_ROADMAP_PRIMARY=your_primary_roadmap_groq_key
GROQ_ROADMAP_FALLBACK_1=your_backup_roadmap_groq_key

# Why No Reply - Rejection isolation endpoints (1 primary, 2 fallbacks)
GROQ_WHY_NO_REPLY_PRIMARY=your_primary_why_no_reply_groq_key
GROQ_WHY_NO_REPLY_FALLBACK_1=your_backup_why_no_reply_groq_key_1
GROQ_WHY_NO_REPLY_FALLBACK_2=your_backup_why_no_reply_groq_key_2

# CV builder - Resume optimization bullet points (1 primary, 1 fallback)
GROQ_RESUME_BUILDER_PRIMARY=your_primary_resume_groq_key
GROQ_RESUME_BUILDER_FALLBACK_1=your_backup_resume_groq_key

# JD parsing - Translation endpoints (1 primary, 1 fallback)
GROQ_JD_TRANSLATE_PRIMARY=your_primary_jd_groq_key
GROQ_JD_TRANSLATE_FALLBACK_1=your_backup_jd_groq_key
